# ─────────────────────────────────────────────
# Mobilier Malin — Variables d'environnement
# ─────────────────────────────────────────────

# URL publique du site
NEXT_PUBLIC_SITE_URL=https://mobiliermalin.com

# ─────────────────────────────────────────────
# Sanity CMS — catalogue produits + Studio
# ─────────────────────────────────────────────
# Doc setup : /sanity-setup/README.md
# Le Studio est accessible sur /studio (intégré au site).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-09-01

# ─────────────────────────────────────────────
# Stripe — paiement en ligne
# ─────────────────────────────────────────────
# Sur https://dashboard.stripe.com → Developers → API keys
# Sans la clé, le bouton "Acheter" renvoie un message d'erreur clair.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# Optionnel — clé publique pour usage côté client si besoin futur
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# ─────────────────────────────────────────────
# Email transactionnel (formulaire de contact)
# ─────────────────────────────────────────────
# Sans RESEND_API_KEY, les messages sont juste loggés dans Vercel logs.
# RESEND_API_KEY=re_xxxxxxxxxx
# EMAIL_FROM_ADDRESS=contact@mobiliermalin.com
# EMAIL_FROM_NAME="Mobilier Malin"

# ─────────────────────────────────────────────
# Mode maintenance / coming soon
# ─────────────────────────────────────────────
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_TOKEN=
