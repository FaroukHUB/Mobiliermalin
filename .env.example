# ─────────────────────────────────────────────
# Mobilier Malin — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ─────────────────────────────────────────────

# Payload
PAYLOAD_SECRET=remplacer-par-une-longue-chaine-aleatoire-de-64-caracteres
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Database — Supabase Postgres (production)
# IMPORTANT pour Vercel : utiliser le **Transaction Pooler** (port 6543)
# pas le Session Pooler (port 5432) — beaucoup plus rapide en serverless.
# Format Supabase Connect → "Transaction pooler" :
DATABASE_URI=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Pour le dev local, on peut basculer sur SQLite (pas de serveur a installer)
# Decommenter la ligne ci-dessous et commenter DATABASE_URI ci-dessus
# DATABASE_URI=file:./mobiliermalin.db

# Site public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Mobilier Malin"

# ─────────────────────────────────────────────
# Mode maintenance / coming soon (DESACTIVE par defaut)
# ─────────────────────────────────────────────
# Le site n'etant pas encore indexe par Google, la maintenance est inutile en dev.
# A REACTIVER plus tard, juste avant le lancement officiel, pour faire la surprise au client.
# - "true"  : tout le public voit /maintenance (statut 503, noindex)
# - "false" : site accessible normalement
# L'admin /admin et l'API /api restent toujours accessibles peu importe la valeur.
MAINTENANCE_MODE=false

# Token secret pour contourner la maintenance quand elle sera reactivee plus tard.
# Visite https://ton-site.com/?bypass=CE_TOKEN une fois -> cookie pose 30 jours -> tu vois le vrai site.
# Pour reverrouiller : https://ton-site.com/?lock=1
MAINTENANCE_BYPASS_TOKEN=

# ─────────────────────────────────────────────
# Supabase Storage (pour les images produits)
# ─────────────────────────────────────────────
# Sans ces variables, les uploads sont stockes localement (dev seulement).
# Sur Vercel, c'est OBLIGATOIRE — sinon les images uploadees disparaissent
# au prochain deploiement.
#
# Comment obtenir les valeurs :
# 1. Supabase → Storage → "Create bucket" → nom : "mobilier-malin-media"
#    → Visibilite : Public (pour que les images s'affichent sur le site)
# 2. Supabase → Project Settings → Storage → "S3 Connection"
#    → Activer l'acces S3 → copier les Access Key + Secret Access Key
#
SUPABASE_STORAGE_ENDPOINT=https://PROJECTREF.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=eu-west-3
SUPABASE_STORAGE_BUCKET=mobilier-malin-media
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────
# Email transactionnel (Resend) — optionnel
# ─────────────────────────────────────────────
# Sans RESEND_API_KEY, les emails sont juste loggues en console (dev OK).
# Pour la prod : compte gratuit Resend (3000 emails/mois) sur resend.com.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM_ADDRESS=contact@mobiliermalin.com
# EMAIL_FROM_NAME="Mobilier Malin"

# ─────────────────────────────────────────────
# Stripe (paiement) — V1.5
# ─────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
