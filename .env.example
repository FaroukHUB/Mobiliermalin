# ─────────────────────────────────────────────
# Mobilier Malin — Variables d'environnement
# ─────────────────────────────────────────────
# Le front Next.js est désormais 100 % statique : pas de DB, pas de CMS.
# La vraie boutique (avec admin produits / commandes) tourne sur WordPress + WooCommerce, séparée.

# URL publique du site vitrine
NEXT_PUBLIC_SITE_URL=https://mobiliermalin.com

# URL de la boutique externe (WordPress + WooCommerce)
# Tant qu'elle n'est pas en ligne, on peut laisser cette valeur par défaut
NEXT_PUBLIC_SHOP_URL=https://shop.mobiliermalin.com

# Email transactionnel (formulaire de contact) — optionnel
# Sans ces variables, les messages sont juste loggés dans Vercel logs.
# RESEND_API_KEY=re_xxxxxxxxxx
# EMAIL_FROM_ADDRESS=contact@mobiliermalin.com
# EMAIL_FROM_NAME="Mobilier Malin"

# ─────────────────────────────────────────────
# Mode maintenance / coming soon (DESACTIVE par defaut)
# ─────────────────────────────────────────────
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_TOKEN=
