{
  "manifest_version": 3,
  "name": "Mobilier Malin — Copier annonce Leboncoin",
  "version": "1.2.0",
  "description": "Extrait une annonce Leboncoin (titre, prix, description, photos) et la copie dans le presse-papier au format prêt à coller dans Claude.",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["https://www.leboncoin.fr/*"],
  "action": {
    "default_title": "Copier l'annonce Leboncoin",
    "default_icon": {
      "16": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "background": {
    "service_worker": "background.js"
  }
}
